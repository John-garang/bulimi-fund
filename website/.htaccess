Options -Indexes
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force non-www
RewriteCond %{HTTP_HOST} ^www\.bulimifund\.com [NC]
RewriteRule ^ https://bulimifund.com%{REQUEST_URI} [L,R=301]

# Redirect old .html pages to clean URLs
RewriteRule ^pages/about\.html$ /about [R=301,L]
RewriteRule ^pages/our-model\.html$ /our-model [R=301,L]
RewriteRule ^pages/our-impact\.html$ /our-impact [R=301,L]
RewriteRule ^pages/farmer-services\.html$ /farmer-services [R=301,L]
RewriteRule ^pages/market-access\.html$ /market-access [R=301,L]
RewriteRule ^pages/partner\.html$ /partner [R=301,L]
RewriteRule ^pages/donate\.html$ /donate [R=301,L]
RewriteRule ^pages/news\.html$ /news [R=301,L]
RewriteRule ^pages/contact\.html$ /contact [R=301,L]
RewriteRule ^pages/faq\.html$ /faq [R=301,L]
RewriteRule ^pages/privacy\.html$ /privacy [R=301,L]
RewriteRule ^pages/terms\.html$ /terms [R=301,L]
RewriteRule ^pages/safeguarding\.html$ /safeguarding [R=301,L]

# Serve clean URLs from folders
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]

# Custom 404
ErrorDocument 404 /404/index.html
